# ─── Registry ──────────────────────────────────────────
registry=https://registry.npmjs.org/

# ─── Reproducibility ────────────────────────────────────
# Save exact versions (no ^ ~ range prefixes) for lockfile stability
save-exact=true

# ─── Peer Dependencies ──────────────────────────────────
# Accept legacy peer dep behavior (pnpm-style) — avoids ERR_PNPM_PEER_DEP_ISSUES
legacy-peer-deps=true

# ─── Publishing (global defaults) ───────────────────────
# ⚠️  tag=beta applies to ALL packages in this monorepo by default.
#     Package-level .npmrc files (e.g. packages/create-mdxhub/.npmrc)
#     override this with their own tag if needed.
#     Remove this line if you publish stable packages from root.
tag=beta
