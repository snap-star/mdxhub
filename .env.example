# Site URL (for sitemap, RSS, SEO)
VITE_SITE_URL=https://yourdomain.com

# Disqus shortname for blog comments
VITE_DISQUS_SHORTNAME=your-disqus-shortname

# Analytics ID (optional)
# VITE_ANALYTICS_ID=G-XXXXXXXXXX

# GitHub token for issue creation (optional)
# VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# Error tracking endpoint (optional)
# VITE_ERROR_TRACKING_DSN=https://your-error-service.com/report
